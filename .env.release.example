# 多人版配置示例，复制为 .env.release 后填写。不要提交真实配置。
APP_AUTH_ENABLED=true
APP_BIND_HOST=127.0.0.1
APP_RUNTIME_UID=1000
APP_RUNTIME_GID=1000
APP_WORKER_COUNT=2
APP_PROCESS_MEMORY=1g
APP_PROCESS_CPUS=1.0
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
# 每位成员通过管理员用户接口创建独立账号，不启用共享普通账号。
APP_USER_PASSWORD=
APP_ALLOW_OUTBOUND_NETWORK=false
APP_ALLOW_STDIO_MCP=false
APP_ALLOW_HTTP_TOOLS=false
APP_ALLOW_REMOTE_MCP=false
APP_ALLOW_WEB_SEARCH=false
APP_ALLOW_REMOTE_INSTALL=false
APP_MODEL_HOST_ALLOWLIST=api.openai.com
APP_REMOTE_HOST_ALLOWLIST=
APP_STDIO_COMMAND_ALLOWLIST=
APP_TASK_QUEUE=agentnexus:tasks
APP_TASK_MAX_RETRIES=2
APP_TASK_TIMEOUT_SECONDS=1800
APP_MAX_MODEL_CALLS=32
APP_MODEL_TIMEOUT_SECONDS=90
# 总重试上限包含非流式备用请求；每次尝试均占用模型预算。
APP_MODEL_MAX_RETRIES=3
APP_MODEL_RETRY_BACKOFF_SECONDS=0.6
APP_HTTP_TOOL_TIMEOUT_SECONDS=30
APP_HTTP_TOOL_MAX_RETRIES=0
APP_MCP_TIMEOUT_SECONDS=60
APP_MCP_MAX_RETRIES=0
APP_MAX_TOOL_CALLS=32
# 两个 Worker 时每用户占用一个，给其他用户保留执行容量。
APP_MAX_CONCURRENT_TASKS_PER_USER=1
APP_MAX_UPLOAD_MB=20
APP_MAX_TASK_ATTACHMENTS_MB=40
# 容器内路径；API 与 Worker 通过 Compose 共用配置和数据挂载。
APP_UPLOAD_DIR=/app/data/uploads
APP_ARTIFACT_DIR=/app/data/artifacts
APP_SECRET_KEY_FILE=/app/data/.secret_key
OPENAI_API_KEY=
