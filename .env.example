APP_HTTP_POLICY_ALLOWLIST=
APP_POLICY_RULES_JSON=[]
APP_SKILL_LOCAL_ROOTS=
APP_MAX_UPLOAD_MB=20
APP_MAX_TASK_ATTACHMENTS_MB=40
APP_MODEL_TIMEOUT_SECONDS=90
APP_MODEL_MAX_RETRIES=3
APP_MODEL_RETRY_BACKOFF_SECONDS=0.6
APP_HTTP_TOOL_TIMEOUT_SECONDS=30
APP_HTTP_TOOL_MAX_RETRIES=0
APP_MCP_TIMEOUT_SECONDS=60
APP_MCP_MAX_RETRIES=0
APP_ARTIFACT_DIR=./data/artifacts
APP_UPLOAD_DIR=./data/uploads
APP_NODE_BINARY=node
APP_ARTIFACT_TOOL_ENTRYPOINT=
APP_PRESENTATION_TIMEOUT_SECONDS=180
APP_DETERMINISTIC_STREAM_CHARS=8
APP_DETERMINISTIC_STREAM_DELAY_MS=20
APP_SECRET_KEY=
APP_SECRET_KEY_FILE=./data/.secret_key
APP_ALLOW_REMOTE_INSTALL=false
APP_REMOTE_INSTALL_HOST_ALLOWLIST=github.com,raw.githubusercontent.com,gitlab.com
OPENAI_API_KEY=
OPENAI_BASE_URL=
