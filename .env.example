APP_WORKER_COUNT=1
APP_TASK_QUEUE=agentnexus:tasks
APP_TASK_MAX_RETRIES=2
APP_TASK_TIMEOUT_SECONDS=1800
APP_MAX_MODEL_CALLS=32
APP_MAX_TOOL_CALLS=32
APP_MAX_CONCURRENT_TASKS_PER_USER=2
APP_ALLOW_OUTBOUND_NETWORK=false
APP_ALLOW_HTTP_TOOLS=false
APP_ALLOW_STDIO_MCP=false
APP_ALLOW_REMOTE_MCP=false
APP_ALLOW_WEB_SEARCH=false
APP_ALLOW_HTTP_POLICY=false
