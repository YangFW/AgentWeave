# Third-party engine sandbox (Codex / Claude Code / container)
# Put secrets in .env.local or .env.release. Do not bake them into agentnexus-runner.
APP_WORKSPACES_ROOT=./data/workspaces
APP_RUNNER_IMAGE=agentnexus-runner:latest
APP_RUNNER_CPUS=2.0
APP_RUNNER_MEMORY=4g
